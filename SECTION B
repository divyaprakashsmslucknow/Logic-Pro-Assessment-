class Student:
    def __init__(self, name, marks):
        self.name = name  # private
        self.marks = marks # private

    def get_name(self):
        return self.name
    def get_marks(self):
        return self.__marks

    # Setter
    def set_name(self, name):
        self.name = name
    def set_marks(self, marks):
        if marks >= 0:
            self.__marks = marks
        else:
            print("Invalid marks")

    def display(self):
        print(f"Name: {self.name}, Marks: {self.marks}")

s1 = Student("Divya", 85)
s1.display()
s1.set_marks(90)
print("After update:", s1.get_marks())

