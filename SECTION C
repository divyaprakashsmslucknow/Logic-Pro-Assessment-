#Tables: students(student_id PK, student_name, city, course_id FK); courses(course_id PK, course_name, course_fee); results(result_id PK, student_id FK, subject, marks).
SELECT s.student_name, s.city, c.course_name, r.subject, r.marks
FROM students s
JOIN courses c ON s.course_id = c.course_id
LEFT JOIN results r ON s.student_id = r.student_id;


#14
SELECT c.course_name, COUNT(s.student_id) AS total_students, AVG(r.marks) AS avg_marks
FROM courses c
JOIN students s ON c.course_id = s.course_id
JOIN results r ON s.student_id = r.student_id
GROUP BY c.course_name
HAVING AVG(r.marks) > 70;

#15
WITH AvgMarks AS (
    SELECT student_id, AVG(marks) AS avg_marks
    FROM results
    GROUP BY student_id
)
SELECT s.student_name, a.avg_marks,
RANK() OVER (PARTITION BY s.course_id ORDER BY a.avg_marks DESC) AS rank_in_course
FROM students s
JOIN AvgMarks a ON s.student_id = a.student_id;

